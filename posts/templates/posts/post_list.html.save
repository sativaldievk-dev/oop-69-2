[<!DOCTYPE html>
<html lang="ru">
<head>
    <meta carset="UTF-8
    <title>Посты</title>
</head>
<body>

<h1>Активные посты</h1>

{% for post in posts %}
    <h2>
        <a href="{% url 'post_detail' post.pk %}">
            {{ post.title }}
        </a>
    </h2>

    <p>{{ post.description }}</p>
{% empty %}
    <p>Активных постов нет.</p>
{% endfor %}

</body>
</html>
